# ===================================================================
# OneShop Environment Configuration Template
# Sao chép tệp này thành .env hoặc thiết lập các biến môi trường tương ứng
# KHÔNG ghi secret thật vào git repository
# ===================================================================

# Server Port
PORT=8080

# Database Configuration (Microsoft SQL Server)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=OneShopDB
DB_USERNAME=oneshop_user
DB_PASSWORD=your_database_password_here
DB_TRUST_SERVER_CERTIFICATE=true

# Mail Server Configuration (Gmail App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# JWT Security
# Chuỗi bí mật ngẫu nhiên tối thiểu 256 bits (32 ký tự trở lên base64)
JWT_SECRET=your_random_base64_secret_key_minimum_256_bits_length_here
JWT_EXPIRATION_MS=86400000
JWT_COOKIE_SECURE=false

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
